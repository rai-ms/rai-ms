{
  "manifest_version": 3,
  "name": "Email Scraper",
  "version": "1.0.0",
  "description": "Scrape visible emails from the current page.",
  "permissions": ["activeTab","storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
